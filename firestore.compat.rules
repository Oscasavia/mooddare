// Compatibility rollout: preserve existing profile/username behavior until
// the profile migration in docs/RELEASE.md is complete. Posts and comments
// use the tested production rules. Do not use the legacy allowance for new features.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function validUsername(name) {
      return name is string && name.matches('^[a-zA-Z0-9_]{3,20}$')
        && name.matches('.*[a-zA-Z].*')
        && name.matches('^[a-zA-Z0-9].*[a-zA-Z0-9]$')
        && !name.matches('.*__.*');
    }
    function validUsernameChange(collection, id) {
      let name = request.resource.data.get('username', null);
      return (collection != 'usernames' || validUsername(id))
        && (collection != 'users' || name == null || validUsername(name)
          || (exists(/databases/$(database)/documents/users/$(id)) && name == resource.data.get('username', null)));
    }
    match /{collection}/{id} {
      allow read, delete: if signedIn() && !(collection in ['posts', 'reports', 'dareInvites']);
      allow create, update: if signedIn() && !(collection in ['posts', 'reports', 'dareInvites']) && validUsernameChange(collection, id);
      match /{subcollection}/{document=**} {
        allow read, write: if signedIn() && !(collection in ['posts', 'reports', 'dareInvites']) && !(subcollection in ['comments', 'replies', 'following', 'followers', 'blocked', 'savedDares']);
      }
    }
    match /users/{uid}/blocked/{authorId} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid) && uid != authorId
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
    }
    function validDarePrompt(data) {
      return data.dareText is string && data.dareText.size() > 0 && data.dareText.size() <= 500
        && data.dareText.matches('(?s).*[^\\s].*')
        && ((!('moodId' in data) && !('moodName' in data))
          || (data.moodId is string && data.moodId.size() > 0 && data.moodId.size() <= 128
            && !data.moodId.matches('.*/.*')
            && data.moodName is string && data.moodName.size() > 0 && data.moodName.size() <= 80));
    }
    match /users/{uid}/savedDares/{dareId} {
      allow read, delete: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['dareText','moodId','moodName','createdAt'])
        && validDarePrompt(request.resource.data)
        && request.resource.data.createdAt == request.time;
    }
    match /dareInvites/{inviteId} {
      function participant() {
        return signedIn() && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid);
      }
      // A sender can check its deterministic invitation ID before creating it.
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/dareInvites/$(inviteId)) || participant());
      allow list, delete: if participant();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['dareText','moodId','moodName','createdAt','senderId','recipientId','opened'])
        && validDarePrompt(request.resource.data)
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId != request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && exists(/databases/$(database)/documents/users/$(request.resource.data.recipientId))
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/following/$(request.resource.data.recipientId))
        && existsAfter(/databases/$(database)/documents/users/$(request.resource.data.recipientId)/following/$(request.auth.uid))
        && !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/blocked/$(request.resource.data.recipientId))
        && !existsAfter(/databases/$(database)/documents/users/$(request.resource.data.recipientId)/blocked/$(request.auth.uid))
        && request.resource.data.opened == false
        && request.resource.data.createdAt == request.time;
      allow update: if owner(resource.data.recipientId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['opened'])
        && request.resource.data.opened == true;
    }
    function canFollow(follower, target) {
      return signedIn() && request.auth.uid == follower && follower != target
        && exists(/databases/$(database)/documents/users/$(follower))
        && exists(/databases/$(database)/documents/users/$(target))
        && !existsAfter(/databases/$(database)/documents/users/$(follower)/blocked/$(target))
        && !existsAfter(/databases/$(database)/documents/users/$(target)/blocked/$(follower))
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
    }
    match /users/{follower}/following/{target} {
      allow read: if signedIn();
      allow create: if canFollow(follower, target)
        && getAfter(/databases/$(database)/documents/users/$(target)/followers/$(follower)).data.createdAt == request.time;
      allow delete: if signedIn() && (request.auth.uid == follower || request.auth.uid == target)
        && !existsAfter(/databases/$(database)/documents/users/$(target)/followers/$(follower));
    }
    match /users/{target}/followers/{follower} {
      allow read: if signedIn();
      allow create: if canFollow(follower, target)
        && getAfter(/databases/$(database)/documents/users/$(follower)/following/$(target)).data.createdAt == request.time;
      allow delete: if signedIn() && (request.auth.uid == follower || request.auth.uid == target)
        && !existsAfter(/databases/$(database)/documents/users/$(follower)/following/$(target));
    }
    match /posts/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['dareText','mediaUrl','mediaPath','mediaType','authorId','createdAt','expiresAt','likedBy','moodId','moodName'])
        && ((!('moodId' in request.resource.data) && !('moodName' in request.resource.data))
          || (request.resource.data.moodId is string && request.resource.data.moodId.size() > 0 && request.resource.data.moodId.size() <= 128
            && request.resource.data.moodName is string && request.resource.data.moodName.size() > 0 && request.resource.data.moodName.size() <= 80))
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.dareText is string
        && request.resource.data.dareText.size() > 0 && request.resource.data.dareText.size() <= 500
        && request.resource.data.mediaType in ['image','video']
        && request.resource.data.mediaPath == 'posts/' + request.auth.uid + '/' + id + (request.resource.data.mediaType == 'image' ? '.jpg' : '.mp4')
        && request.resource.data.mediaUrl is string && request.resource.data.mediaUrl.size() <= 2048
        && request.resource.data.mediaUrl.matches('https://firebasestorage.googleapis.com/.*')
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(25, 'h')
        && request.resource.data.likedBy == [];
      allow update: if signedIn()
        && ((owner(resource.data.authorId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleting']) && request.resource.data.deleting == true)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
        && request.resource.data.likedBy is list
        && request.resource.data.likedBy.size() <= 10000
        && request.resource.data.likedBy.size() == request.resource.data.likedBy.toSet().size()
        && request.resource.data.likedBy.toSet().difference(resource.data.likedBy.toSet()).hasOnly([request.auth.uid])
        && resource.data.likedBy.toSet().difference(request.resource.data.likedBy.toSet()).hasOnly([request.auth.uid])));
      allow delete: if owner(resource.data.authorId);
      match /comments/{commentId} {
        function validText() {
          return request.resource.data.text is string
            && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
            && request.resource.data.text.matches('(?s).*[^\\s].*');
        }
        function ownLikeOnly() {
          let before = resource.data.get('likedBy', []);
          let after = request.resource.data.likedBy;
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
            && after is list && after.size() <= 10000
            && after.size() == after.toSet().size()
            && after.toSet().difference(before.toSet()).hasOnly([request.auth.uid])
            && before.toSet().difference(after.toSet()).hasOnly([request.auth.uid]);
        }
        allow read: if signedIn() && exists(/databases/$(database)/documents/posts/$(id));
        allow create: if signedIn() && exists(/databases/$(database)/documents/posts/$(id))
          && get(/databases/$(database)/documents/posts/$(id)).data.get('deleting', false) == false
          && request.resource.data.keys().hasOnly(['authorId', 'text', 'createdAt', 'likedBy'])
          && request.resource.data.authorId == request.auth.uid && validText()
          && request.resource.data.get('likedBy', []) == []
          && request.resource.data.createdAt == request.time;
        allow update: if signedIn() && exists(/databases/$(database)/documents/posts/$(id))
          && ((owner(resource.data.authorId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
            && validText() && request.resource.data.editedAt == request.time)
            || ownLikeOnly()
            || ((owner(resource.data.authorId) || get(/databases/$(database)/documents/posts/$(id)).data.authorId == request.auth.uid)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleting'])
              && request.resource.data.deleting == true));
        allow delete: if signedIn() && (resource.data.authorId == request.auth.uid
          || get(/databases/$(database)/documents/posts/$(id)).data.authorId == request.auth.uid);
      }
      match /replies/{replyId} {
        function validText() {
          return request.resource.data.text is string
            && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
            && request.resource.data.text.matches('(?s).*[^\\s].*');
        }
        function ownLikeOnly() {
          let before = resource.data.get('likedBy', []);
          let after = request.resource.data.likedBy;
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
            && after is list && after.size() <= 10000
            && after.size() == after.toSet().size()
            && after.toSet().difference(before.toSet()).hasOnly([request.auth.uid])
            && before.toSet().difference(after.toSet()).hasOnly([request.auth.uid]);
        }
        // Older clients omit both target fields and reply to the root author.
        function validReplyTarget() {
          let data = request.resource.data;
          return !data.keys().hasAny(['replyToId', 'replyToAuthorId'])
            || (data.replyToAuthorId is string
              && (!data.keys().hasAny(['replyToId'])
                ? data.replyToAuthorId == data.rootAuthorId
                : (data.replyToId is string && data.replyToId.size() > 0 && data.replyToId.size() <= 128
                  && exists(/databases/$(database)/documents/posts/$(id)/replies/$(data.replyToId))
                  && get(/databases/$(database)/documents/posts/$(id)/replies/$(data.replyToId)).data.parentId == data.parentId
                  && get(/databases/$(database)/documents/posts/$(id)/replies/$(data.replyToId)).data.authorId == data.replyToAuthorId)));
        }
        allow read: if signedIn() && exists(/databases/$(database)/documents/posts/$(id));
        allow create: if signedIn() && exists(/databases/$(database)/documents/posts/$(id))
          && get(/databases/$(database)/documents/posts/$(id)).data.get('deleting', false) == false
          && request.resource.data.keys().hasOnly(['authorId', 'text', 'createdAt', 'likedBy', 'parentId', 'rootAuthorId', 'replyToId', 'replyToAuthorId'])
          && request.resource.data.authorId == request.auth.uid && validText()
          && request.resource.data.parentId is string
          && exists(/databases/$(database)/documents/posts/$(id)/comments/$(request.resource.data.parentId))
          && get(/databases/$(database)/documents/posts/$(id)/comments/$(request.resource.data.parentId)).data.get('deleting', false) == false
          && request.resource.data.rootAuthorId == get(/databases/$(database)/documents/posts/$(id)/comments/$(request.resource.data.parentId)).data.authorId
          && validReplyTarget()
          && request.resource.data.get('likedBy', []) == []
          && request.resource.data.createdAt == request.time;
        allow update: if signedIn() && exists(/databases/$(database)/documents/posts/$(id))
          && ((owner(resource.data.authorId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
            && validText() && request.resource.data.editedAt == request.time)
            || ownLikeOnly());
        allow delete: if signedIn() && (resource.data.authorId == request.auth.uid
          || resource.data.rootAuthorId == request.auth.uid
          || get(/databases/$(database)/documents/posts/$(id)).data.authorId == request.auth.uid);
      }

    }
    // Allows account deletion to find and remove only the caller's comments,
    // including comments whose parent was removed during an interrupted cleanup.
    match /{path=**}/comments/{commentId} {
      allow read, delete: if signedIn() && resource.data.authorId == request.auth.uid;
      allow update: if signedIn() && resource.data.authorId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleting'])
        && request.resource.data.deleting == true;
    }
    match /{path=**}/replies/{replyId} {
      allow read, delete: if signedIn() && (resource.data.authorId == request.auth.uid || resource.data.rootAuthorId == request.auth.uid);
    }
    match /reports/{id} {
      function validPostReport() {
        return request.resource.data.keys().hasOnly(['postId','reporterId','reason','createdAt'])
          && request.resource.data.postId is string
          && id == request.auth.uid + '_' + request.resource.data.postId
          && request.resource.data.reason == 'inappropriate';
      }
      function validUserReport() {
        let data = request.resource.data;
        return data.keys().hasOnly(['userId','reporterId','reason','createdAt'])
          && data.userId is string && data.userId != request.auth.uid
          && id == request.auth.uid + '_user_' + data.userId
          && exists(/databases/$(database)/documents/users/$(data.userId))
          && data.reason in ['spam','harassment','hate','sexualContent','violence','impersonation','other'];
      }
      function validReport() {
        return signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && (validUserReport() || validPostReport());
      }
      allow create: if validReport();
      allow update: if validReport() && owner(resource.data.reporterId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reason','createdAt']);
      allow read, delete: if owner(resource.data.reporterId);
    }
  }
}
