rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    match /posts/{uid}/{file} {
      allow get: if request.auth != null;
      allow list, delete: if owner(uid);
      allow create, update: if owner(uid) && request.resource.size > 0
        && request.resource.size <= 30 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'video/mp4'];
    }
    match /profile_pictures/{uid}/{file} {
      allow get: if request.auth != null;
      allow list, delete: if owner(uid);
      allow create, update: if owner(uid) && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024 && request.resource.contentType == 'image/jpeg';
    }
    match /profile_pictures/{uid} {
      allow get: if request.auth != null;
      allow delete: if owner(uid);
    }
  }
}
